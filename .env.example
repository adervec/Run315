# Flask session signing + Garmin token encryption key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth client ID -> Web).
# Authorised redirect URI: http://127.0.0.1:5000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key for the coach review (console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional
DATABASE_PATH=run315.db
SYNC_INTERVAL_HOURS=6
PORT=5000
HTTPS=false
