{
  "name": "Run315",
  "short_name": "Run315",
  "description": "Garmin analytics, race projections, routes, trails and territory.",
  "start_url": "{{ url_for('index') }}",
  "scope": "{{ url_for('index') }}",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eceff3",
  "theme_color": "#101828",
  "icons": [
    {
      "src": "{{ url_for('static', filename='icon-192.png') }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ url_for('static', filename='icon-512.png') }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ url_for('static', filename='icon-512.png') }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Vitals",
      "url": "{{ url_for('vitals_page') }}",
      "description": "What actually responds to your training"
    },
    {
      "name": "Routes",
      "url": "{{ url_for('routes_page') }}",
      "description": "Draw a route"
    },
    {
      "name": "Territory",
      "url": "{{ url_for('intvl') }}",
      "description": "Tiles claimed"
    }
  ]
}
